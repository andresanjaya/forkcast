# Server-only Gemini key. Leave blank to use manual demo logging.
GEMINI_API_KEY=
GEMINI_MODEL=

# Public Supabase project settings. Leave blank to use local demo storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
